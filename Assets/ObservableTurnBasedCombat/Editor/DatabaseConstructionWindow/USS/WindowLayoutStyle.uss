VisualElement {
}

.otbc-root {
    background-color: rgba(0, 0, 0, 0);
    width: 100%;
    height: 100%;
    flex-direction: row;
}

.otbc-side-bar {
    flex-grow: 1;
    background-color: rgba(0, 0, 0, 0);
    max-width: 160px;
    min-width: 160px;
    -unity-text-align: middle-left;
    margin-left: 10px;
    margin-right: 10px;
    margin-top: 10px;
    margin-bottom: 10px;
}
