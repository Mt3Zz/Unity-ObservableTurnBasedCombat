<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Packages/com.mt3zz.observableturnbasedcombat/Editor/DatabaseConstructionWindow/USS/WindowLayoutStyle.uss?fileID=7433441132597879392&amp;guid=2e7f0e1311dcd20479d82e5770cb2fec&amp;type=3#WindowLayoutStyle" />
    <ui:VisualElement name="root" class="otbc-root">
        <ui:VisualElement name="sidebar" class="sidebar--flex-grow sidebar--size sidebar--margin sidebar--text">
            <ui:ScrollView horizontal-scroller-visibility="Hidden" name="page-selector" class="sidebar__content--grow">
                <ui:ListView name="unit-storage-selector" header-title="Unit" show-foldout-header="true" show-bound-collection-size="false" />
                <ui:ListView name="component-storage-selector" show-foldout-header="true" header-title="Unit Component" show-bound-collection-size="false" />
                <ui:ListView show-bound-collection-size="false" show-foldout-header="true" header-title="Command" name="command-storage-selector" />
                <ui:ListView show-foldout-header="true" header-title="Equipment" show-bound-collection-size="false" />
            </ui:ScrollView>
            <ui:VisualElement name="preference-link" class="preference-selector__footer">
                <ui:Button name="preference-link__button" text="Preferences" class="preference-selector__button--text" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="Border" style="border-left-width: 10px; border-left-color: rgba(0, 0, 0, 0.5); border-right-color: rgba(0, 0, 0, 0.5); border-top-color: rgba(0, 0, 0, 0.5); border-bottom-color: rgba(0, 0, 0, 0.5); max-width: 0;" />
        <ui:ScrollView name="content" horizontal-scroller-visibility="Hidden" style="width: 100%; margin-left: 10px; margin-right: 10px; margin-top: 10px; margin-bottom: 10px;" />
    </ui:VisualElement>
</ui:UXML>
