<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Packages/com.mt3zz.observableturnbasedcombat/Editor/USS/DatabaseConstructionWindow/WindowPreference.uss?fileID=7433441132597879392&amp;guid=ff0afeee574870143959eafdfd37c5f6&amp;type=3#WindowPreference" />
    <ui:VisualElement name="preferences" class="preferences--margin">
        <ui:Label text="Observable Turn-Based Combat" name="preferences__title" class="preferences__title--size preferences__title--margin" />
        <ui:VisualElement name="preferences__preferences-field">
            <ui:VisualElement name="root-folder-preferences" class="preferences-field--margin">
                <ui:Label text="Root Folder" name="root-folder-preferences__title" class="preferences__subtitle" />
                <ui:TextField binding-path="_folderPreferences._rootFolder" readonly="true" name="root-folder-preferences__current-folder" />
                <ui:VisualElement style="flex-direction: row;">
                    <ui:Button text="Set Root Folder" name="root-folder-preferences__folder-setter" />
                    <ui:Button text="Initialize Root Folder" name="root-folder-preferences__folder-initializer" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="unit-preferences" class="preferences-field--margin" style="flex-grow: 1; background-color: rgba(0, 0, 0, 0);">
                <ui:Label text="Unit" name="unit-preferences__title" class="preferences__subtitle" />
                <ui:VisualElement style="flex-direction: row;">
                    <uie:ObjectField type="ObservableTurnBasedCombat.ObservableUnit.TypeStorage, ObservableTurnBasedCombat" binding-path="_unitPreferences._unitType" label="Type Preference" style="flex-grow: 1;" />
                    <ui:Button text="Create New Type Preference" name="unit-preferences__type-preference-factory" />
                </ui:VisualElement>
                <ui:VisualElement style="flex-grow: 1; background-color: rgba(0, 0, 0, 0);">
                    <ui:Label text="Storages" name="unit-preferences__storages-title" />
                    <ui:ListView name="unit-preferences__storages" binding-path="_unitPreferences._unitStorages" show-add-remove-footer="true" show-bound-collection-size="false" />
                    <ui:VisualElement style="flex-direction: row;">
                        <ui:Button text="Create New Storage" name="unit-preferences__storage-factory" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
